{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pambala-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://pambala-api.monait.workers.dev/api",
    "NEXT_PUBLIC_APP_URL": "https://pambala-ui.monait.workers.dev"
  }
}
